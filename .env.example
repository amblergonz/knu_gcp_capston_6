# 이 파일을 .env 로 복사한 뒤 키를 채우세요. .env 는 .gitignore 에 있습니다.
#
# Gemini 는 "쿠폰을 생성"하지 않습니다.
# 할인율(5 / 10 / 15%)은 intent 점수 구간으로 stream-worker 가 정하고,
# Gemini 가 하는 일은 팝업 문구 3개(title / body / cta)를 상황에 맞게 쓰는 것뿐입니다.
# 키가 비어 있으면 고정 한국어 폴백 문구로 빠집니다 (payload 의 copy_source 로 구분).
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=
